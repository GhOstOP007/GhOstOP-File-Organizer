{
  "name": "ghostop-studio",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first desktop file organizer",
  "author": "GhOstOP LAB",
  "main": "main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "lab.ghostop.studio",
    "productName": "GhOstOP Studio",
    "files": [
      "main.cjs",
      "preload.cjs",
      "organizer.cjs",
      "ui/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
